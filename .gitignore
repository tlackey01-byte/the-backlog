Source/master_games_final.backup_*.json
Source/steamgriddb_api_key.txt
server.log

# build.py's intermediate; the same data ships inside docs/games/index.html
Source/games_compact.json
worker/.wrangler/
worker/.dev.vars

# Cloudflare R2 credentials for Source/upload_covers.py
Source/r2_credentials.json

# IGDB (Twitch app) credentials for Source/find_cover_candidates.py
Source/igdb_credentials.json

# Firebase service-account key for Source/sync_site.py -- full admin access to the project.
# The second pattern catches a fresh download still under Firebase's own file name.
Source/firebase_service_account.json
*firebase-adminsdk*.json

# Scratch output of Source/find_cover_candidates.py: the gap list, candidates, and review page
Source/cover_review/

# Cover images live in the Cloudflare R2 bucket the worker serves from /img/, not in git:
# ~120MB that git would keep every version of forever. This is the local staging copy that
# Source/refetch_covers.py writes and Source/upload_covers.py pushes to R2.
docs/games/covers/

# Local wrangler state (a root-level one appears if wrangler is run outside worker/)
.wrangler/
__pycache__/
